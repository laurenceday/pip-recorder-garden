{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laurenceday.github.io/pip-recorder-garden/schema/lesson.schema.json",
  "title": "Recorder Garden lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceIdeaId",
    "order",
    "title",
    "shortTitle",
    "chapter",
    "kind",
    "difficulty",
    "story",
    "childCue",
    "adultCue",
    "successCue",
    "pattern",
    "stableMs",
    "toleranceCents",
    "tips",
    "accent"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 48 },
    "sourceIdeaId": { "type": "string", "pattern": "^idea-[0-9]{3}$" },
    "order": { "type": "integer", "minimum": 1, "maximum": 999 },
    "title": { "type": "string", "minLength": 3, "maxLength": 56 },
    "shortTitle": { "type": "string", "minLength": 1, "maxLength": 22 },
    "chapter": { "enum": ["First sounds", "Finger steps", "Echoes", "Little tunes", "Explore"] },
    "kind": { "enum": ["hold", "sequence", "explore"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "story": { "type": "string", "minLength": 12, "maxLength": 180 },
    "childCue": { "type": "string", "minLength": 5, "maxLength": 130 },
    "adultCue": { "type": "string", "minLength": 8, "maxLength": 220 },
    "successCue": { "type": "string", "minLength": 3, "maxLength": 100 },
    "pattern": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "beats"],
        "properties": {
          "note": { "enum": ["C5", "D5", "E5", "F5", "G5", "A5", "B5", "C6"] },
          "beats": { "enum": [0.5, 1, 2, 4] }
        }
      }
    },
    "stableMs": { "type": "integer", "minimum": 350, "maximum": 1500 },
    "toleranceCents": { "type": "integer", "minimum": 40, "maximum": 150 },
    "tips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 4, "maxLength": 110 }
    },
    "accent": { "enum": ["marigold", "periwinkle", "rose", "sky", "leaf"] }
  }
}
